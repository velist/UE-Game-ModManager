<Window x:Class="UEModManager.Views.AccountSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账户设置" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource CyberModalWindow}">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="OnCloseWindow"/>
    </Window.CommandBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头像区 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <!-- 点击头像本身即可更换（与下方按钮同一处理器）。Background 必须显式给值，
                 Transparent 也算命中；不给 Background 的 Border 中间是空的，点不着。 -->
            <!-- 头像用 Background=ImageBrush 画，不要放 Image 子元素：
                 Border 的 CornerRadius 只裁 Background，ClipToBounds 按矩形裁，
                 「CornerRadius + ClipToBounds 包一个 Image」裁不出圆形（原先就是方的）。
                 点击头像本身即可更换；Background 必须始终有值，否则中间是空的、点不着。 -->
            <Border x:Name="AvatarPreviewBorder"
                    Width="80" Height="80" CornerRadius="40" BorderBrush="{StaticResource CyberBorderBrush}"
                    BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,12"
                    Background="{StaticResource SurfaceBrush}"
                    Cursor="Hand" ToolTip="点击更换头像"
                    MouseLeftButtonUp="AvatarArea_MouseLeftButtonUp">
                <Image x:Name="AvatarPlaceholder" Width="46" Height="46"
                       Source="pack://application:,,,/mnlogo.ico"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Button Content="更换头像" Style="{StaticResource CyberSecondaryButton}"
                    Height="32" Click="ChangeAvatar_Click"/>
        </StackPanel>

        <!-- 表单 -->
        <StackPanel Grid.Row="1">
            <!-- 只留一个名称字段，绑 LocalUser.DisplayName。
                 原先还有一个"用户名"绑 Username，但 Username 是云端所有的：
                 SyncUserToLocal 每次登录都执行 existingUser.Username = cloudUser.Username，
                 用户在这里改了下次登录就被覆盖——一个改了不生效的输入框比没有更糟。 -->
            <TextBlock Text="名称" Style="{StaticResource CyberLabel}" Margin="0,0,0,6"/>
            <TextBox x:Name="DisplayNameTextBox" Style="{StaticResource CyberTextBox}" Margin="0,0,0,16"/>

            <TextBlock Text="个性签名" Style="{StaticResource CyberLabel}" Margin="0,0,0,6"/>
            <TextBox x:Name="SignatureTextBox" Style="{StaticResource CyberTextBox}" Height="60"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="14,10"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Style="{StaticResource CyberSecondaryButton}"
                    Width="80" Height="36" Margin="0,0,12,0" Click="Cancel_Click"/>
            <Button Content="保存" Style="{StaticResource CyberPrimaryButton}"
                    Width="80" Height="36" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
