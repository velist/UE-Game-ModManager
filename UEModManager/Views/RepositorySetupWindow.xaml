<Window x:Class="UEModManager.Views.RepositorySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UEModManager.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UEModManager.Views"
        mc:Ignorable="d"
        Title="{loc:Text &#x27;MOD 存储设置&#x27;}" Width="640" MinWidth="560"
        SizeToContent="Height" MaxHeight="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Foreground="{DynamicResource SetupTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <!-- 首次运行引导。使用真实磁盘容量，路径检查与持久化交给 RepositorySetupService。 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SetupBoolToVisibility" />

        <!-- Vector icons use the same 24-unit geometries as the HTML reference. -->
        <Geometry x:Key="SetupDriveGeometry">M6,5 L18,5 Q21,5 21,8 L21,16 Q21,19 18,19 L6,19 Q3,19 3,16 L3,8 Q3,5 6,5 M3,13 L21,13 M7,16 L7.1,16 M10,16 L10.1,16</Geometry>
        <Geometry x:Key="SetupFolderGeometry">M20,20 L4,20 Q2,20 2,18 L2,6 Q2,4 4,4 L9,4 L11,7 L20,7 Q22,7 22,9 L22,18 Q22,20 20,20 Z</Geometry>
        <Geometry x:Key="SetupCheckGeometry">M5,12 L9,16 L19,6</Geometry>
        <Geometry x:Key="SetupChevronGeometry">M9,5 L16,12 L9,19</Geometry>

        <Style x:Key="SetupKeyboardFocusStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="8" RadiusY="8"
                                   Stroke="{DynamicResource SetupAccentHoverBrush}" StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SetupTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SetupLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SetupKeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SetupHoverBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SetupPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SetupActionButtonStyle}">
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Background" Value="{DynamicResource SetupAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SetupAccentInkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SetupAccentHoverBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SetupTextButtonStyle" TargetType="Button" BasedOn="{StaticResource SetupActionButtonStyle}">
            <Setter Property="Height" Value="28" /><Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SetupAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource SetupAccentHoverBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SetupCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource SetupActionButtonStyle}">
            <Setter Property="Width" Value="44" /><Setter Property="Height" Value="43" />
            <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SetupMutedBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SetupCloseHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource SetupOnCloseBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SetupCapacityMeterStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource SetupTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SetupMeterBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <!-- A real RadioButton preserves focus, arrow-key navigation and single selection. -->
        <Style x:Key="SetupDriveOptionStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SetupTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SetupKeyboardFocusStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="RowBorder" Padding="14" CornerRadius="9" BorderThickness="1"
                            BorderBrush="Transparent" Background="{DynamicResource SetupRowBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="13" /><ColumnDefinition Width="*" /><ColumnDefinition Width="13" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                            <Border x:Name="DriveIconBorder" Width="36" Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SetupLineBrush}" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path x:Name="DriveIcon" Data="{StaticResource SetupDriveGeometry}" Stroke="{DynamicResource SetupSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid MinHeight="25">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <DockPanel LastChildFill="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border DockPanel.Dock="Right" x:Name="BadgeBorder" Visibility="{Binding BadgeVisibility}" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource SetupHoverBrush}" VerticalAlignment="Center" ToolTip="{Binding BadgeText}">
                                            <TextBlock x:Name="BadgeText" Text="{Binding BadgeText}" FontSize="10" LineHeight="16" Foreground="{DynamicResource SetupSecondaryBrush}" />
                                        </Border>
                                        <TextBlock x:Name="DriveName" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock x:Name="CapacityText" Text="{Binding FreeText}" FontFamily="Bahnschrift" FontSize="22" FontWeight="Normal" />
                                        <TextBlock Text="{Binding FreeUnitLabel}" FontSize="11" Foreground="{DynamicResource SetupSecondaryBrush}" Margin="5,0,0,3" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,0" MinHeight="15">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="UsedMeter" Value="{Binding UsedPercent, Mode=OneWay}" Style="{StaticResource SetupCapacityMeterStyle}" VerticalAlignment="Center" ToolTip="{Binding UsedDescription}" AutomationProperties.Name="{loc:Text &#x27;已用空间百分比&#x27;}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalLabel}" FontSize="11" Foreground="{DynamicResource SetupMutedBrush}" Margin="14,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding GameVolumeText}" Visibility="{Binding GameVolumeVisibility}"
                                           FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SetupAccentBrush}" />
                            </StackPanel>
                            <Grid Grid.Column="4" Width="19" Height="19" VerticalAlignment="Center">
                                <Ellipse x:Name="RadioOutline" Stroke="{DynamicResource SetupRadioOutlineBrush}" StrokeThickness="1" />
                                <Viewbox x:Name="RadioCheck" Width="12" Height="12" Visibility="Collapsed"><Canvas Width="24" Height="24"><Path Data="{StaticResource SetupCheckGeometry}" Stroke="{DynamicResource SetupAccentInkBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SetupHoverBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SetupSelectedBrush}" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource SetupSelectedLineBrush}" />
                            <Setter TargetName="DriveIconBorder" Property="BorderBrush" Value="{DynamicResource SetupIconSelectedLineBrush}" />
                            <Setter TargetName="DriveIconBorder" Property="Background" Value="{DynamicResource SetupIconSelectedBrush}" />
                            <Setter TargetName="DriveIcon" Property="Stroke" Value="{DynamicResource SetupAccentBrush}" />
                            <Setter TargetName="CapacityText" Property="Foreground" Value="{DynamicResource SetupAccentBrush}" />
                            <Setter TargetName="UsedMeter" Property="Foreground" Value="{DynamicResource SetupAccentBrush}" />
                            <Setter TargetName="RadioOutline" Property="Fill" Value="{DynamicResource SetupAccentBrush}" />
                            <Setter TargetName="RadioOutline" Property="Stroke" Value="{DynamicResource SetupAccentBrush}" />
                            <Setter TargetName="RadioCheck" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsChecked" Value="True" /></MultiTrigger.Conditions><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SetupSelectedHoverBrush}" /></MultiTrigger>
                        <DataTrigger Binding="{Binding IsRecommended}" Value="True"><Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource SetupBadgeBrush}" /><Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SetupAccentBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding BadgeBrushKey}" Value="StatusOrangeBrush"><Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SetupWarningBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter TargetName="CapacityText" Property="Foreground" Value="{DynamicResource SetupWarningBrush}" /><Setter TargetName="UsedMeter" Property="Foreground" Value="{DynamicResource SetupWarningBrush}" /></DataTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /><Setter TargetName="DriveName" Property="Foreground" Value="{DynamicResource SetupMutedBrush}" /><Setter TargetName="CapacityText" Property="Foreground" Value="{DynamicResource SetupMutedBrush}" /><Setter TargetName="RadioOutline" Property="StrokeDashArray" Value="2 2" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="SetupDriveTemplate" DataType="{x:Type local:RepositoryDriveRow}">
            <RadioButton Style="{StaticResource SetupDriveOptionStyle}" GroupName="StorageDrive"
                         IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsSelectable}" />
        </DataTemplate>
        <Style x:Key="SetupSmallVolumesToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="36" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SetupMutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SetupKeyboardFocusStyle}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="3,0"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Viewbox x:Name="ExpandIcon" Width="14" Height="14" RenderTransformOrigin="0.5,0.5"><Canvas Width="24" Height="24"><Path Data="{StaticResource SetupChevronGeometry}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                        <TextBlock x:Name="ExpandText" Grid.Column="1" Text="{loc:Text &#x27;显示小容量卷&#x27;}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{TemplateBinding Tag}" FontSize="11" VerticalAlignment="Center" />
                    </Grid></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ExpandText" Property="Text" Value="{loc:Text &#x27;收起小容量卷&#x27;}" /><Setter TargetName="ExpandIcon" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource SetupTextBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource SetupSurfaceBrush}" BorderBrush="{DynamicResource SetupLineBrush}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SetupTitleBarBrush}" BorderBrush="{DynamicResource SetupSoftLineBrush}" BorderThickness="0,0,0,1" CornerRadius="13,13,0,0" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="16,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="17" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                    <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="M12,3 L21,8 L12,13 L3,8 Z M3,12 L12,17 L21,12 M3,16 L12,21 L21,16" Stroke="{DynamicResource SetupAccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" /></Canvas></Viewbox>
                    <TextBlock Grid.Column="1" Text="{loc:Text &#x27;MOD 存储设置&#x27;}" FontSize="12" Foreground="{DynamicResource SetupSecondaryBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <Button x:Name="LanguageToggle" Grid.Column="2" Content="{loc:Text 'EN'}" Click="LanguageToggle_Click" Style="{StaticResource SetupTextButtonStyle}" MinWidth="48" Margin="0,0,6,0" ToolTip="{loc:Text '语言'}" AutomationProperties.Name="{loc:Text '语言'}" />
                    <Button Grid.Column="3" Style="{StaticResource SetupCloseButtonStyle}" Click="Close_Click" ToolTip="{loc:Text &#x27;关闭（Esc）&#x27;}" AutomationProperties.Name="{loc:Text &#x27;关闭窗口&#x27;}"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox></Button>
                </Grid>
            </Border>
            <ScrollViewer x:Name="BodyScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="28,24,28,22">
                    <TextBlock Text="{loc:Text &#x27;给 MOD 找个合适的位置&#x27;}" FontSize="26" FontWeight="SemiBold" LineHeight="36" />
                    <TextBlock Text="{loc:Text &#x27;优先选择游戏所在的磁盘，并预留足够的空间。&#x27;}" Foreground="{DynamicResource SetupSecondaryBrush}" FontSize="14" Margin="0,6,0,0" LineHeight="22" TextWrapping="Wrap" />
                    <Grid Margin="0,22,0,10">
                        <TextBlock Text="{loc:Text &#x27;选择磁盘&#x27;}" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Width="12" Height="3" CornerRadius="2" Background="{DynamicResource SetupMeterBrush}" Margin="0,0,6,0" /><TextBlock Text="{loc:Text &#x27;进度条为已用空间&#x27;}" FontSize="11" Foreground="{DynamicResource SetupMutedBrush}" /></StackPanel>
                    </Grid>
                    <ItemsControl x:Name="DriveList" ItemTemplate="{StaticResource SetupDriveTemplate}" KeyboardNavigation.DirectionalNavigation="Continue" />
                    <TextBlock x:Name="EmptyDrivesText" Visibility="Collapsed" Text="{loc:Text &#x27;暂未找到可用磁盘，可以选择其他文件夹。&#x27;}" TextWrapping="Wrap" Foreground="{DynamicResource SetupSecondaryBrush}" Margin="0,4,0,16" />
                    <ToggleButton x:Name="SmallVolumesToggle" Style="{StaticResource SetupSmallVolumesToggleStyle}" Margin="0,-2,0,0" AutomationProperties.Name="{loc:Text &#x27;显示或收起小容量卷&#x27;}" />
                    <StackPanel Visibility="{Binding IsChecked, ElementName=SmallVolumesToggle, Converter={StaticResource SetupBoolToVisibility}}" Margin="0,2,0,0">
                        <TextBlock Text="{loc:Text &#x27;这些卷容量较小，建议优先选择上方磁盘。&#x27;}" FontSize="12" Foreground="{DynamicResource SetupMutedBrush}" Margin="0,2,0,9" TextWrapping="Wrap" />
                        <ItemsControl x:Name="SmallDriveList" ItemTemplate="{StaticResource SetupDriveTemplate}" />
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource SetupSoftLineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,17,0,0">
                        <StackPanel>
                            <Grid Height="28">
                                <TextBlock Text="{loc:Text &#x27;MOD 将存放在&#x27;}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="{loc:Text &#x27;选择其他文件夹…&#x27;}" HorizontalAlignment="Right" Style="{StaticResource SetupTextButtonStyle}" Click="BrowseFolder_Click" />
                            </Grid>
                            <Border Margin="0,7,0,0" MinHeight="46" Padding="12,0" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource SetupLineBrush}" Background="{DynamicResource SetupInputBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource SetupFolderGeometry}" Stroke="{DynamicResource SetupMutedBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" /></Canvas></Viewbox>
                                    <TextBlock x:Name="ResolvedPathText" Grid.Column="2" FontFamily="Consolas" FontSize="13" Margin="0,10,4,10" VerticalAlignment="Center" TextWrapping="Wrap"  AutomationProperties.Name="{loc:Text &#x27;最终保存路径&#x27;}" AutomationProperties.LiveSetting="Polite"><Run x:Name="PathRootRun" Foreground="{DynamicResource SetupAccentBrush}" /><Run x:Name="PathRemainderRun" /></TextBlock>
                                    <Button x:Name="CopyPathButton" Grid.Column="3" Width="32" Height="32" Padding="0" Style="{StaticResource SetupTextButtonStyle}" Click="CopyPath_OnClick" ToolTip="{loc:Text &#x27;复制路径&#x27;}" AutomationProperties.Name="{loc:Text &#x27;复制保存路径&#x27;}" Foreground="{DynamicResource SetupMutedBrush}"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M10,8 L18,8 Q20,8 20,10 L20,19 Q20,21 18,21 L10,21 Q8,21 8,19 L8,10 Q8,8 10,8 M16,8 L16,5 Q16,3 14,3 L5,3 Q3,3 3,5 L3,14 Q3,16 5,16 L8,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" /></Canvas></Viewbox></Button>
                                </Grid>
                            </Border>
                            <Grid x:Name="DefaultPathHint" Margin="0,10,0,0">
                                <Grid.Style><Style TargetType="Grid"><Setter Property="TextElement.Foreground" Value="{DynamicResource SetupSecondaryBrush}" /></Style></Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Viewbox Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top"><Canvas Width="24" Height="24"><Ellipse Width="18" Height="18" Canvas.Left="3" Canvas.Top="3" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Grid}}" StrokeThickness="1.6" /><Path Data="M12,11 L12,16 M12,7.5 L12.1,7.5" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Grid}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                                <TextBlock x:Name="PathHintText" Grid.Column="2" Text="{loc:Text &#x27;MOD 将独立存放，不会与已有文件混放。&#x27;}" FontSize="12" LineHeight="19" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                            <ItemsControl x:Name="IssueList" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{Binding Brush}" Margin="0,3,0,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" LineHeight="19"
                                                       TextWrapping="Wrap" Foreground="{Binding Brush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="FeedbackText" Visibility="Collapsed" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource SetupSecondaryBrush}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{DynamicResource SetupSoftLineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SetupTitleBarBrush}" Padding="24,17" CornerRadius="0,0,13,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text &#x27;之后可在设置中更改&#x27;}" FontSize="11" Foreground="{DynamicResource SetupMutedBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{loc:Text &#x27;以后再说&#x27;}" Style="{StaticResource SetupActionButtonStyle}" Click="Skip_Click" />
                    <Button x:Name="ConfirmButton" Grid.Column="3" Style="{StaticResource SetupPrimaryButtonStyle}" Click="Confirm_Click" IsDefault="True" AutomationProperties.Name="{loc:Text &#x27;使用此位置&#x27;}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{loc:Text &#x27;使用此位置&#x27;}" VerticalAlignment="Center" /><Viewbox Width="16" Height="16" Margin="9,0,0,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource SetupChevronGeometry}" Stroke="{DynamicResource SetupAccentInkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox></StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
