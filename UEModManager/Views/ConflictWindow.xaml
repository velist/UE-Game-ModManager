<Window x:Class="UEModManager.Views.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UEModManager.Localization"
        Title="{loc:Text '冲突检测'}"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource CyberModalWindow}">

    <Window.Resources>
        <!-- 冲突组卡片。标题用单行 TextTrimming 而不是水平 StackPanel：
             成员名长度不可控，StackPanel 会把卡片撑出面板宽度。 -->
        <DataTemplate x:Key="ConflictGroupTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Foreground="{StaticResource Text100Brush}"
                               FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}"
                               Foreground="{StaticResource Text200Brush}"
                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding RunCommand}"
                                        MinWidth="110" Height="34" Margin="0,0,8,8"
                                        Style="{StaticResource CyberSecondaryButton}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="{loc:Text '查看资源列表'}" Margin="0,4,0,0"
                              Foreground="{StaticResource Text200Brush}" FontSize="12">
                        <ItemsControl ItemsSource="{Binding Assets}" Margin="12,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{StaticResource Text200Brush}"
                                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DuplicateTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Text}"
                               Foreground="{StaticResource Text100Brush}"
                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding RunCommand}"
                                        MinWidth="110" Height="34" HorizontalAlignment="Left"
                                        Style="{StaticResource CyberSecondaryButton}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SharedComponentTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           Foreground="{StaticResource Text100Brush}" FontSize="12"
                           Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Detail}"
                           Foreground="{StaticResource Text200Brush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Command="{Binding RunCommand}"
                                    MinWidth="120" Height="28" Margin="8,0,0,0"
                                    Style="{StaticResource CyberGhostButton}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 标题与统计 ═══ -->
        <Border Grid.Row="0" Padding="24,20,24,12">
            <StackPanel>
                <TextBlock Text="{loc:Text '冲突检测'}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Text100Brush}"/>
                <TextBlock x:Name="HeaderText" Text="{Binding HeaderText}"
                           Foreground="{StaticResource Text200Brush}" FontSize="12" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- ═══ 内容 ═══ -->
        <ScrollViewer Grid.Row="1" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource CyberScrollViewer}">
            <StackPanel>
                <!-- 空状态 -->
                <TextBlock x:Name="EmptyStateText" Text="{loc:Text '未发现 MOD 冲突'}"
                           FontSize="16" Foreground="{StaticResource Text200Brush}"
                           HorizontalAlignment="Center" Margin="0,40,0,40"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}"
                              ItemTemplate="{StaticResource ConflictGroupTemplate}"/>

                <TextBlock Text="{loc:Text '重复'}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Text200Brush}" Margin="0,8,0,8"
                           Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ItemsControl x:Name="DuplicateList" ItemsSource="{Binding Duplicates}"
                              ItemTemplate="{StaticResource DuplicateTemplate}"/>

                <TextBlock Text="{loc:Text '共享组件（已自动处理，无需操作）'}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Text200Brush}" Margin="0,8,0,8"
                           Visibility="{Binding HasSharedComponents, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ItemsControl x:Name="SharedComponentList" ItemsSource="{Binding SharedComponents}"
                              ItemTemplate="{StaticResource SharedComponentTemplate}"/>

                <TextBlock Text="{loc:Text '无法分析'}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Text200Brush}" Margin="0,8,0,8"
                           Visibility="{Binding HasUnanalyzable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ItemsControl x:Name="UnanalyzableList" ItemsSource="{Binding Unanalyzable}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Detail}"
                                       Foreground="{StaticResource Text200Brush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ 状态行 ═══ -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="{Binding StatusText}"
                   Foreground="{StaticResource PrimaryBrush}" FontSize="12"
                   Margin="24,10,24,0" TextTrimming="CharacterEllipsis"/>

        <!-- ═══ 底部：一键处理 + 关闭 ═══ -->
        <Border Grid.Row="3" Padding="24,14,24,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 每个冲突组保留第一个成员、禁用其余；没有冲突组时置灰。 -->
                <Button x:Name="ResolveAllButton" Content="{loc:Text '一键处理'}"
                        MinWidth="110" Height="36" Margin="0,0,10,0"
                        IsEnabled="{Binding HasGroups}"
                        Style="{StaticResource CyberPrimaryButton}"
                        Click="ResolveAll_Click"/>
                <Button Content="{loc:Text '关闭'}" MinWidth="96" Height="36"
                        Style="{StaticResource CyberSecondaryButton}"
                        Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
