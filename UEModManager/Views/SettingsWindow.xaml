<Window x:Class="UEModManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UEModManager.Localization"
        Title="{loc:Text &#x27;系统设置&#x27;}" Height="480" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource CyberModalWindow}">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="OnCloseWindow"/>
    </Window.CommandBindings>

    <Grid>
        <!-- 弹窗背景层 -->
        <Image x:Name="DialogBgImage" Stretch="UniformToFill" Visibility="Collapsed"/>
        <Border x:Name="DialogBgOverlay" Visibility="Collapsed" Background="#80030303"/>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="192"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 左侧导航栏 ── -->
        <Border Grid.Column="0" Background="#CC030303"
                BorderBrush="#99272727" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="{loc:Text &#x27;系统设置&#x27;}" FontSize="11" FontWeight="Bold"                           Foreground="{StaticResource Text600Brush}" Margin="12,8,0,12"/>

                <RadioButton x:Name="TabGeneral" GroupName="SettingsTabs" IsChecked="True"
                             Style="{StaticResource CyberNavItem}" Content="{loc:Text &#x27;常规参数&#x27;}"
                             Tag="&#xE713;" Click="TabButton_Click"/>
                <RadioButton x:Name="TabPaths" GroupName="SettingsTabs"
                             Style="{StaticResource CyberNavItem}" Content="{loc:Text &#x27;游戏路径&#x27;}"
                             Tag="&#xE838;" Click="TabButton_Click"/>
                <RadioButton x:Name="TabAppearance" GroupName="SettingsTabs"
                             Style="{StaticResource CyberNavItem}" Content="{loc:Text &#x27;外观设置&#x27;}"
                             Tag="&#xE790;" Click="TabButton_Click"/>
                <RadioButton x:Name="TabDeploy" GroupName="SettingsTabs"
                             Style="{StaticResource CyberNavItem}" Content="{loc:Text &#x27;MOD 文件与位置&#x27;}"
                             Tag="&#xE835;" Click="TabButton_Click"/>
                <RadioButton x:Name="TabFeedback" GroupName="SettingsTabs"
                             Style="{StaticResource CyberNavItem}" Content="{loc:Text &#x27;反馈与诊断&#x27;}"
                             Tag="&#xE939;" Click="TabButton_Click"/>

                <!-- 弹性间距 -->
                <Border Height="120"/>

                <RadioButton x:Name="TabAbout" GroupName="SettingsTabs"
                             Style="{StaticResource CyberNavItem}" Content="{loc:Text &#x27;关于软件&#x27;}"
                             Tag="&#xE946;" Click="TabButton_Click"/>
            </StackPanel>
        </Border>

        <!-- ── 右侧内容区 ── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 常规参数面板 -->
            <ScrollViewer x:Name="GeneralPanel" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32">
                <TextBlock Text="{loc:Text &#x27;常规参数&#x27;}" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource Text100Brush}" Margin="0,0,0,28"/>

                <!-- 检查更新与匿名统计。
                     两件事共用一个开关是有意的：它们本来就是同一个网络请求
                     （客户端问"有没有新版本"，服务端顺手记一笔"有多少人在用"）。
                     拆成两个开关会逼用户去理解一件他不需要理解的事，
                     而"关掉统计但保留更新检查"在实现上根本不是两条链路。 -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Text &#x27;检查更新与匿名统计&#x27;}" FontSize="14" Foreground="{StaticResource Text200Brush}"/>
                        <TextBlock Text="{loc:Text &#x27;启动时看一眼有没有新版本，同时发送一个随机编号和版本号，让我们知道有多少人在用。不含邮箱、电脑名、文件路径和 MOD 信息。&#x27;}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Text500Brush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="UpdateAndStatsToggle" Grid.Column="1"
                              Style="{StaticResource CyberToggleSwitch}" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="#99272727"/>

                <!-- 语言选择 -->
                <Grid Margin="0,28,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Text &#x27;显示语言&#x27;}" FontSize="14" Foreground="{StaticResource Text200Brush}"/>
                        <TextBlock Text="{loc:Text &#x27;界面显示语言设置&#x27;}" FontSize="12"
                                   Foreground="{StaticResource Text500Brush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="140"
                              Style="{StaticResource CyberComboBox}" VerticalAlignment="Center"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="{loc:Text &#x27;简体中文&#x27;}"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                </Grid>
                <Border Height="1" Background="#99272727"/>

                <!-- 关闭行为 -->
                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="CloseActionLabel" Text="{loc:Text &#x27;关闭行为&#x27;}" FontSize="14" Foreground="{StaticResource Text200Brush}"/>
                        <TextBlock x:Name="CloseActionDesc" Text="{loc:Text &#x27;点击关闭按钮时的行为&#x27;}" FontSize="12"
                                   Foreground="{StaticResource Text500Brush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="CloseActionComboBox" Grid.Column="1" Width="160"
                              Style="{StaticResource CyberComboBox}" VerticalAlignment="Center">
                        <ComboBoxItem Content="{loc:Text &#x27;每次询问&#x27;}"/>
                        <ComboBoxItem Content="{loc:Text &#x27;直接退出&#x27;}"/>
                        <ComboBoxItem Content="{loc:Text &#x27;最小化到任务栏&#x27;}"/>
                    </ComboBox>
                </Grid>

            </StackPanel>
            </ScrollViewer>

            <!-- 游戏路径面板 -->
            <ScrollViewer x:Name="PathsPanel" Grid.Row="0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32">
                <TextBlock Text="{loc:Text &#x27;游戏路径&#x27;}" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource Text100Brush}" Margin="0,0,0,8"/>
                <TextBlock x:Name="CurrentGameHint" Text="{loc:Text &#x27;当前游戏：未选择&#x27;}"
                           FontSize="12" Foreground="{StaticResource Text500Brush}" Margin="0,0,0,24"/>

                <!-- 游戏图标（非必填） -->
                <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                        Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" x:Name="SettingsGameIconBorder" Width="64" Height="64"
                                CornerRadius="14" Background="{StaticResource BgBaseBrush}"
                                BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                                ClipToBounds="True" Cursor="Hand"
                                MouseLeftButtonDown="SettingsGameIcon_Click">
                            <Grid>
                                <Image x:Name="SettingsGameIconPreview" Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                                <StackPanel x:Name="SettingsGameIconPlaceholder"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🖼" FontSize="20" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Text700Brush}" Opacity="0.5"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{loc:Text &#x27;游戏图标&#x27;}" Foreground="{StaticResource Text200Brush}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Text &#x27;支持 PNG/JPG（非必选）&#x27;}" Foreground="{StaticResource Text500Brush}"
                                       FontSize="11" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Text &#x27;选择图片&#x27;}" Style="{StaticResource CyberSecondaryButton}"
                                        Height="28" Padding="12,0" FontSize="12"
                                        Click="SettingsGameIcon_BrowseClick"/>
                                <Button x:Name="SettingsClearIconBtn" Content="{loc:Text &#x27;清除&#x27;}"
                                        Style="{StaticResource CyberSecondaryButton}"
                                        Height="28" Padding="12,0" FontSize="12" Margin="8,0,0,0"
                                        Foreground="{StaticResource Text500Brush}"
                                        Visibility="Collapsed"
                                        Click="SettingsGameIcon_ClearClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Text &#x27;游戏安装路径&#x27;}" Style="{StaticResource CyberLabel}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GamePathTextBox" Grid.Column="0"
                             Style="{StaticResource CyberTextBox}"/>
                    <Button Grid.Column="1" Content="{loc:Text &#x27;浏览&#x27;}" Style="{StaticResource CyberSecondaryButton}"
                            Width="72" Margin="8,0,0,0" Height="40"
                            Click="BrowseGamePath_Click"/>
                </Grid>

                <TextBlock Text="{loc:Text &#x27;MOD 文件夹路径&#x27;}" Style="{StaticResource CyberLabel}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ModPathTextBox" Grid.Column="0"
                             Style="{StaticResource CyberTextBox}"/>
                    <Button Grid.Column="1" Content="{loc:Text &#x27;浏览&#x27;}" Style="{StaticResource CyberSecondaryButton}"
                            Width="72" Margin="8,0,0,0" Height="40"
                            Click="BrowseModPath_Click"/>
                </Grid>

                <TextBlock Text="{loc:Text &#x27;备份文件夹路径&#x27;}" Style="{StaticResource CyberLabel}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BackupPathTextBox" Grid.Column="0"
                             Style="{StaticResource CyberTextBox}"/>
                    <Button Grid.Column="1" Content="{loc:Text &#x27;浏览&#x27;}" Style="{StaticResource CyberSecondaryButton}"
                            Width="72" Margin="8,0,0,0" Height="40"
                            Click="BrowseBackupPath_Click"/>
                </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 外观设置面板 -->
            <ScrollViewer x:Name="AppearancePanel" Grid.Row="0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32">
                    <TextBlock x:Name="AppearanceTitle" Text="{loc:Text &#x27;外观设置&#x27;}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Text100Brush}" Margin="0,0,0,24"/>

                    <!-- 背景模式 -->
                    <TextBlock x:Name="BgModeLabel" Text="{loc:Text &#x27;背景模式&#x27;}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Text400Brush}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 默认渐变 -->
                        <Border x:Name="BgModeGradient" Grid.Column="0" CornerRadius="14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderThickness="2" Padding="8" Cursor="Hand"
                                MouseLeftButtonDown="BgModeGradient_Click">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Border Height="52" CornerRadius="10" Margin="0,0,0,8" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#030303" Offset="0"/>
                                            <GradientStop Color="#0f172a" Offset="0.5"/>
                                            <GradientStop Color="#030303" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="BgModeGradientText" Text="{loc:Text &#x27;默认渐变&#x27;}" FontSize="11"
                                           Foreground="{StaticResource Text300Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 自定义图片 -->
                        <Border x:Name="BgModeImage" Grid.Column="2" CornerRadius="14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="2"
                                Padding="8" Cursor="Hand"
                                MouseLeftButtonDown="BgModeImage_Click">
                            <StackPanel>
                                <Border Height="52" CornerRadius="10" Margin="0,0,0,8"
                                        Background="{StaticResource BgBaseBrush}">
                                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="{StaticResource Text600Brush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="BgModeImageText" Text="{loc:Text &#x27;自定义图片&#x27;}" FontSize="11"
                                           Foreground="{StaticResource Text300Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 纯色背景 -->
                        <Border x:Name="BgModeSolid" Grid.Column="4" CornerRadius="14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="2"
                                Padding="8" Cursor="Hand"
                                MouseLeftButtonDown="BgModeSolid_Click">
                            <StackPanel>
                                <Border Height="52" CornerRadius="10" Margin="0,0,0,8"
                                        Background="#0a0a0f"/>
                                <TextBlock x:Name="BgModeSolidText" Text="{loc:Text &#x27;纯色背景&#x27;}" FontSize="11"
                                           Foreground="{StaticResource Text300Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 图片选择（仅 Image 模式可见） -->
                    <Grid x:Name="ImagePickerPanel" Margin="0,0,0,20" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BgImagePathBox" Grid.Column="0" IsReadOnly="True"
                                 Style="{StaticResource CyberTextBox}" Height="36" FontSize="12"/>
                        <Button x:Name="BrowseBgImageBtn" Grid.Column="1" Content="{loc:Text &#x27;选择图片&#x27;}"
                                Style="{StaticResource CyberSecondaryButton}"
                                Width="80" Height="36" Margin="8,0,0,0" FontSize="12"
                                Click="BrowseBgImage_Click"/>
                    </Grid>

                    <Border Height="1" Background="#99272727" Margin="0,0,0,20"/>

                    <!-- 背景透明度 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="BgOpacityLabel" Text="{loc:Text &#x27;背景透明度&#x27;}" FontSize="14"
                                       Foreground="{StaticResource Text200Brush}"/>
                            <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="100" Value="70"
                                    Style="{StaticResource CyberSlider}" Margin="0,8,0,0"
                                    ValueChanged="BgOpacitySlider_ValueChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="BgOpacityValue" Grid.Column="1" Text="70%"
                                   FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Bottom" Margin="12,0,0,8" MinWidth="40"
                                   TextAlignment="Right"/>
                    </Grid>

                    <!-- 背景模糊度 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="BgBlurLabel" Text="{loc:Text &#x27;背景模糊度&#x27;}" FontSize="14"
                                       Foreground="{StaticResource Text200Brush}"/>
                            <Slider x:Name="BgBlurSlider" Minimum="0" Maximum="100" Value="0"
                                    Style="{StaticResource CyberSlider}" Margin="0,8,0,0"
                                    ValueChanged="BgBlurSlider_ValueChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="BgBlurValue" Grid.Column="1" Text="0%"
                                   FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Bottom" Margin="12,0,0,8" MinWidth="40"
                                   TextAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="#99272727" Margin="0,0,0,20"/>

                    <!-- 应用到弹窗 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ApplyToDialogsLabel" Text="{loc:Text &#x27;应用到弹窗&#x27;}" FontSize="14"
                                       Foreground="{StaticResource Text200Brush}"/>
                            <TextBlock x:Name="ApplyToDialogsDesc" Text="{loc:Text &#x27;弹窗也显示背景效果&#x27;}" FontSize="12"
                                       Foreground="{StaticResource Text500Brush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ApplyToDialogsToggle" Grid.Column="1"
                                  Style="{StaticResource CyberToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="True"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 关于面板 -->
            <ScrollViewer x:Name="AboutPanel" Grid.Row="0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32">
                    <TextBlock x:Name="AboutTitle" Text="{loc:Text &#x27;关于软件&#x27;}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Text100Brush}" Margin="0,0,0,28"/>

                    <!-- 捐赠支持 -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="160" Height="160" CornerRadius="14"
                                Background="#FFFFFFFF" ClipToBounds="True"
                                HorizontalAlignment="Center">
                            <Image Source="/捐赠.png" Stretch="Uniform" Margin="4"/>
                        </Border>
                        <TextBlock x:Name="DonationText" Text="{loc:Text &#x27;如果你觉得有帮助，可以请我喝一杯咖啡！&#x27;}" FontSize="12"
                                   Foreground="{StaticResource Text400Brush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- 分隔线 -->
                    <Border Height="1" Background="#99272727" Margin="0,24,0,24"/>

                    <!-- 鸣谢名单 -->
                    <TextBlock x:Name="CreditsTitle" Text="{loc:Text &#x27;鸣谢名单&#x27;}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Text200Brush}" Margin="0,0,0,12"/>
                    <Border CornerRadius="10" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                            Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Text &#x27;胖虎、YUki、Tarnished&#x27;}" FontSize="13"
                                       Foreground="{StaticResource Text300Brush}" TextAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Text &#x27;春告鳥、蘭、虎子&#x27;}" FontSize="13"
                                       Foreground="{StaticResource Text300Brush}" TextAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Text &#x27;神秘不保底男&#x27;}" FontSize="13"
                                       Foreground="{StaticResource Text300Brush}" TextAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Text &#x27;文铭、阪、林墨&#x27;}" FontSize="13"
                                       Foreground="{StaticResource Text300Brush}" TextAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Text &#x27;Daisuke、虎子哥、枪王&#x27;}" FontSize="13"
                                       Foreground="{StaticResource Text300Brush}" TextAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Text &#x27;爱酱MOD管理器交流群全体群友&#x27;}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryBrush}" TextAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- 分隔线 -->
                    <Border Height="1" Background="#99272727" Margin="0,24,0,24"/>

                    <!-- 软件信息 -->
                    <TextBlock Text="{loc:Text &#x27;爱酱MOD管理器&#x27;}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Text200Brush}"/>
                    <TextBlock x:Name="VersionText" Text="" FontSize="13"
                               Foreground="{StaticResource Text500Brush}" Margin="0,4,0,16"/>
                    <TextBlock x:Name="AboutDesc1" Text="{loc:Text &#x27;面向普通玩家的游戏 MOD 管理器，已适配多款热门游戏&#x27;}" FontSize="13"
                               Foreground="{StaticResource Text400Brush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AboutDesc2" Text="{loc:Text &#x27;轻松管理导入、启用、备份与恢复&#x27;}" FontSize="13"
                               Foreground="{StaticResource Text500Brush}" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 部署与仓库面板 -->
            <ScrollViewer x:Name="DeployPanel" Grid.Row="0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32">

                    <!-- MOD 安装方式的选择已于 2026-08-28 移除，只保留文件复制。
                         硬链接虽然省空间，但游戏目录与 MOD 库共用同一份数据，任何就地改写都会
                         同时改掉 MOD 库那份，等于牺牲了备份的隔离性——而备份隔离正是本工具的核心价值。
                         枚举值 DeploymentBackendType.HardLink 保留用于反序列化旧配置，运行时兜底为 Copy。 -->
                    <TextBlock Text="{loc:Text &#x27;MOD 安装方式&#x27;}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Text100Brush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,28"
                               Foreground="{StaticResource Text500Brush}"
                               Text="{loc:Text &#x27;启用 MOD 时，文件从 MOD 库复制到游戏目录。MOD 库始终保留独立的一份，游戏目录里发生什么都不会影响它。&#x27;}"/>

                    <Border Height="1" Background="#99272727" Margin="0,0,0,28"/>

                    <!-- 包仓库路径 -->
                    <TextBlock Text="{loc:Text &#x27;MOD 文件保存位置&#x27;}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Text100Brush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:Text &#x27;已导入的 MOD 会保存在这里，不会直接混进游戏目录&#x27;}" FontSize="12"
                               Foreground="{StaticResource Text500Brush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RepoPathTextBox" Grid.Column="0"
                                 Style="{StaticResource CyberTextBox}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="{loc:Text &#x27;浏览&#x27;}" Style="{StaticResource CyberSecondaryButton}"
                                Width="72" Margin="8,0,0,0" Height="40"
                                Click="BrowseRepoPath_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                        <TextBlock x:Name="RepoSizeText" Text="{loc:Text &#x27;已用空间: 计算中...&#x27;}" FontSize="12"
                                   Foreground="{StaticResource Text500Brush}" Margin="0,0,16,0"/>
                        <TextBlock x:Name="RepoCountText" Text="" FontSize="12"
                                   Foreground="{StaticResource Text500Brush}" Margin="0,0,16,0"/>
                        <TextBlock Text="{loc:Text &#x27;管理仓库&#x27;}" FontSize="12" Foreground="{StaticResource PrimaryBrush}"
                                   Cursor="Hand" TextDecorations="Underline"
                                   MouseLeftButtonDown="ManageRepo_Click"/>
                    </StackPanel>

                    <Border Height="1" Background="#99272727" Margin="0,0,0,28"/>

                    <!-- 导入选项 -->
                    <TextBlock Text="{loc:Text &#x27;导入 MOD 时&#x27;}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Text100Brush}" Margin="0,0,0,20"/>

                    <!-- 导入后自动启用 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Text &#x27;导入后自动启用&#x27;}" FontSize="14" Foreground="{StaticResource Text200Brush}"/>
                            <TextBlock Text="{loc:Text &#x27;导入 MOD 后立即启用并写入游戏目录&#x27;}" FontSize="12"
                                       Foreground="{StaticResource Text500Brush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoDeployToggle" Grid.Column="1"
                                  Style="{StaticResource CyberToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="True"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 反馈与诊断面板 -->
            <ScrollViewer x:Name="FeedbackPanel" Grid.Row="0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32">
                    <TextBlock x:Name="FeedbackTitle" Text="{loc:Text &#x27;反馈与诊断&#x27;}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Text100Brush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="FeedbackSubtitle" Text="{loc:Text &#x27;出问题时导出诊断包发给开发者，或通过下面的渠道直接联系&#x27;}" FontSize="12"
                               Foreground="{StaticResource Text500Brush}" Margin="0,0,0,24"/>

                    <!-- 诊断包导出卡片 -->
                    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                            Padding="20,18" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="32" Height="32" CornerRadius="10"
                                        Background="#1a06b6d4" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DiagBundleTitle" Text="{loc:Text &#x27;导出诊断包&#x27;}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text100Brush}"/>
                                    <TextBlock x:Name="DiagBundleHint" Text="{loc:Text &#x27;一键打包日志、当前数据快照与最近事务记录&#x27;}" FontSize="11"
                                               Foreground="{StaticResource Text500Brush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#0a0a0f" CornerRadius="10" Padding="14,10" Margin="0,8,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="DiagBundleContentLabel" Text="{loc:Text &#x27;包内容&#x27;}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text400Brush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="DiagBundleContentLines" FontSize="11"
                                               Foreground="{StaticResource Text500Brush}" TextWrapping="Wrap"
                                               LineHeight="18">
                                        <Run Text="{loc:Text &#x27;• console.log + 最近 5 份轮转日志&#x27;}"/><LineBreak/>
                                        <Run Text="{loc:Text &#x27;• Data/ 目录下的 JSON 索引（profiles / packages / categories ...）&#x27;}"/><LineBreak/>
                                        <Run Text="{loc:Text &#x27;• 最近 10 笔变更记录&#x27;}"/><LineBreak/>
                                        <Run Text="{loc:Text &#x27;• 实时健康检查报告&#x27;}"/><LineBreak/>
                                        <Run Text="{loc:Text &#x27;• 元数据：版本号、操作系统、.NET 运行时、当前游戏&#x27;}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#1a16a34a" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="#16a34a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="DiagBundleRedactHint" Grid.Column="1"
                                               Text="{loc:Text &#x27;包内的密码、token、邮箱地址会自动脱敏，可以放心发给开发者&#x27;}"
                                               FontSize="11" Foreground="{StaticResource Text400Brush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Button x:Name="ExportDiagButton" Content="{loc:Text &#x27;导出诊断包&#x27;}"
                                    Style="{StaticResource CyberPrimaryButton}"
                                    HorizontalAlignment="Left" Width="140" Height="36"
                                    Click="ExportDiagnostic_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 反馈渠道卡片 -->
                    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                            Padding="20,18">
                        <StackPanel>
                            <TextBlock x:Name="FeedbackChannelsTitle" Text="{loc:Text &#x27;反馈渠道&#x27;}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text100Brush}" Margin="0,0,0,12"/>

                            <!-- QQ 群 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="QqGroupLabel" Text="{loc:Text &#x27;爱酱MOD管理器交流群&#x27;}"
                                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource Text200Brush}"/>
                                    <TextBlock x:Name="QqGroupNumber" Text="147223127" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text100Brush}" Margin="0,6,0,12"/>
                                    <Button x:Name="JoinQqGroupBtn" Content="{loc:Text &#x27;加入&#x27;}"
                                            Style="{StaticResource CyberSecondaryButton}"
                                            HorizontalAlignment="Left" Width="80" Height="30" FontSize="12"
                                            Click="JoinQqGroup_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border Background="White" CornerRadius="6" Padding="6">
                                        <Image x:Name="QqGroupQrImage" Width="160" Height="160" Stretch="Uniform"
                                               Source="pack://application:,,,/Assets/Community/qq-group-147223127.png"
                                               AutomationProperties.Name="{loc:Text &#x27;爱酱MOD管理器交流群二维码&#x27;}"/>
                                    </Border>
                                    <TextBlock Text="{loc:Text &#x27;使用 QQ 扫码加入&#x27;}" FontSize="11"
                                               Foreground="{StaticResource Text500Brush}" Margin="0,7,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#33272727" Margin="0,4,0,10"/>

                            <!-- 邮箱 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                        Background="#1aef4444" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="#ef4444"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="EmailLabel" Text="{loc:Text &#x27;邮箱&#x27;}" FontSize="13"
                                               Foreground="{StaticResource Text200Brush}"/>
                                    <TextBlock Text="mr.xzuo@foxmail.com" FontSize="11"
                                               Foreground="{StaticResource Text500Brush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="SendEmailBtn" Content="{loc:Text &#x27;发送&#x27;}"
                                        Style="{StaticResource CyberSecondaryButton}"
                                        Width="68" Height="28" FontSize="12"
                                        Click="SendEmail_Click"/>
                            </Grid>

                            <Border Height="1" Background="#33272727" Margin="0,4,0,10"/>

                            <!-- GitHub -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                        Background="#1aa855f7" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="#a855f7"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="GithubLabel" Text="GitHub Issue" FontSize="13"
                                               Foreground="{StaticResource Text200Brush}"/>
                                    <TextBlock Text="github.com/velist/UE-Game-ModManager" FontSize="11"
                                               Foreground="{StaticResource Text500Brush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="OpenGithubBtn" Content="{loc:Text &#x27;打开&#x27;}"
                                        Style="{StaticResource CyberSecondaryButton}"
                                        Width="68" Height="28" FontSize="12"
                                        Click="OpenGithub_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── 底部保存栏 ── -->
            <Border Grid.Row="1" BorderBrush="#99272727" BorderThickness="0,1,0,0"
                    Background="#80030303">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14">
                    <Button Content="{loc:Text &#x27;保存设置&#x27;}" Style="{StaticResource CyberPrimaryButton}"
                            Width="120" Height="36" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
