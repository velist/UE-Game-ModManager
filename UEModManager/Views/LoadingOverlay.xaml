<UserControl x:Class="UEModManager.Views.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:UEModManager.Localization"
             x:Name="Root"
             Visibility="Collapsed"
             IsHitTestVisible="True"
             Focusable="False">
    <!--
      统一加载遮罩。此前"导入"整条链路没有任何进度反馈：点下确认后界面完全冻结，
      用户无法判断是在工作还是已经卡死。这里用既有 CyberDark 令牌做一个转圈指示器，
      颜色/圆角/字体全部取自 Themes/CyberDarkTheme.xaml，不引入第二套视觉语言。
    -->
    <UserControl.Resources>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.9"/>
        </Storyboard>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="MessageText"
                             Storyboard.TargetProperty="Opacity"
                             From="0.45" To="1" Duration="0:0:0.9"/>
        </Storyboard>
    </UserControl.Resources>

    <Border Background="{DynamicResource OverlayBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="36" Height="36" HorizontalAlignment="Center">
                <!-- 底环：暗色轨迹 -->
                <Ellipse Stroke="{DynamicResource SurfaceHoverBrush}" StrokeThickness="3"/>
                <!-- 亮弧：一段四分之一圆弧，靠 RotateTransform 旋转 -->
                <Ellipse Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3"
                         StrokeDashArray="8.6 26" StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="MessageText"
                       Text="{loc:Text '正在处理...'}"
                       Foreground="{DynamicResource Text300Brush}"
                       FontFamily="{DynamicResource InterFont}"
                       FontSize="13" Margin="0,14,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
