<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 版本号不在这里：本项目 GenerateAssemblyInfo=false，这两个属性会被静默忽略。
         唯一事实来源是 Properties/VersionAssemblyInfo.cs，理由与同步清单见该文件。 -->
    <ApplicationIcon>mnlogo.ico</ApplicationIcon>
    <!-- 开启 longPathAware（详见 app.manifest 内的说明）。清单内容刻意与 apphost 默认
         清单保持最小差异，未引入 dpiAware / supportedOS。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 避免 wpftmp 项目重复特性，引入手写 AssemblyInfo 保证版本匹配 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29" />
    <!-- 以下两项为安全加固的显式提升：EF Core 8.0.29 仍传递引用存在高危通告的
         SQLitePCLRaw 2.1.6（GHSA-2m69-gcr7-jv3q），而 System.Text.Json 8.0.0
         受 GHSA-hh2w-p6rv-4g7w 影响。显式声明以覆盖传递版本。
         升级 EF Core 大版本后可重新评估是否仍需保留。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.0.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UEModManager.Core\UEModManager.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="mnlogo.ico" />
    <!-- 同时将 ico 输出为独立文件，供安装程序快捷方式引用 -->
    <None Include="mnlogo.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- 思源黑体 SC（Adobe SIL OFL 1.1）— 三档字重静态嵌入，覆盖所有中文场景。
         拉丁字符仍走系统字体回退（Segoe UI / 系统默认）。 -->
    <Resource Include="Fonts\SourceHanSansSC-Regular.otf" />
    <Resource Include="Fonts\SourceHanSansSC-Medium.otf" />
    <Resource Include="Fonts\SourceHanSansSC-Bold.otf" />
    <!-- OFL 许可文本随安装包分发，满足字体协议合规要求 -->
    <None Include="Fonts\SourceHanSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="捐赠.png" />
    <Resource Include="黑神话悟空MOD-百度网盘.png" />
    <Resource Include="黑神话悟空MOD-迅雷云盘.png" />
    <Resource Include="剑星MOD-百度网盘.png" />
    <Resource Include="剑星MOD-迅雷云盘.png" />
    <Resource Include="光与影百度网盘mod.png" />
    <Resource Include="光与影迅雷云盘mod.png" />
    <Resource Include="明末MOD-百度网盘.png" />
    <Resource Include="明末MOD-迅雷云盘.png" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\GameIcons\*.png;Assets\GameIcons\SOURCES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
