<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyVersion>2.0.5.0</AssemblyVersion>
    <FileVersion>2.0.5.0</FileVersion>
    <!-- annotations → enable（审计项 T-H）。annotations 只让编译器**记录** ?/! 标注给
         下游用，自己一个空引用警告都不报——等于把 Core 里的空值风险留给主项目在运行时发现。
         Core 是纯函数库、由 879 个测试兜底，是全仓最适合先收紧的一层。
         实测切到 enable 后 0 警告（现有代码本就写得干净），所以没有引入任何 `!` 抑制符或
         #pragma。后续新增代码若报 CS86xx，请修真问题，不要用 `!` 糊过去——
         `!` 是"我保证非空"的断言，断言错了就把编译期错误顺延成了运行期 NRE。 -->
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core 仅依赖 Newtonsoft.Json（JsonConfigParser 使用 JToken/JObject）。
         其他基础设施依赖（Sqlite/BCrypt/Http/Logging.Abstractions/SharpCompress 等）
         属于主项目 Infrastructure 层职责，不应渗入 Domain 内核。-->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
