<Window x:Class="UEModManager.Views.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本机账户" Height="680" Width="1050"
        MinHeight="500" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource CyberDarkWindow}">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="OnMinimizeWindow"/>
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="OnMaximizeWindow"/>
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="OnRestoreWindow"/>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="OnCloseWindow"/>
    </Window.CommandBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="本机账户" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource Text100Brush}"/>
                <TextBlock Text="查看本机保存的账户；刷新以获取最新数据。" FontSize="12"
                           Foreground="{StaticResource Text500Brush}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新数据"
                    Style="{StaticResource CyberSecondaryButton}" Height="36" MinWidth="110"
                    VerticalAlignment="Center" Click="RefreshDataButton_Click"/>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMd}"
                    BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                    Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="本机账户数" FontSize="12" Foreground="{StaticResource Text500Brush}"/>
                    <TextBlock x:Name="TotalUsersText" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Text100Brush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMd}"
                    BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                    Padding="16" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="近 30 天登录" FontSize="12" Foreground="{StaticResource Text500Brush}"/>
                    <TextBlock x:Name="ActiveUsersText" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMd}"
                    BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                    Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="本地数据库" FontSize="12" Foreground="{StaticResource Text500Brush}"/>
                    <TextBlock x:Name="DatabaseStatusText" Text="—" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource Text100Brush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UserSearchBox" Style="{StaticResource CyberTextBox}"/>
            <Button Grid.Column="1" Content="搜索" Style="{StaticResource CyberPrimaryButton}"
                    Width="80" Height="40" Margin="8,0,0,0" Click="SearchUsersButton_Click"/>
        </Grid>

        <DataGrid x:Name="UsersDataGrid" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="Transparent" Foreground="{StaticResource Text200Brush}"
                  BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource CyberBorderBrush}"
                  RowBackground="{StaticResource BgBaseBrush}"
                  AlternatingRowBackground="{StaticResource SurfaceBrush}"
                  RowHeight="34"
                  HeadersVisibility="Column">
            <DataGrid.Resources>
                <Style x:Key="AccountCellText" TargetType="TextBlock">
                    <Setter Property="Margin" Value="8,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource Text300Brush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource CyberBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" ElementStyle="{StaticResource AccountCellText}"/>
                <DataGridTextColumn x:Name="EmailColumn" Header="邮箱" Binding="{Binding Email}" Width="*" MinWidth="240" ElementStyle="{StaticResource AccountCellText}"/>
                <DataGridTextColumn x:Name="CreatedAtColumn" Header="注册时间" Binding="{Binding CreatedAt}" Width="170" ElementStyle="{StaticResource AccountCellText}"/>
                <DataGridTextColumn x:Name="LastLoginColumn" Header="最近登录" Binding="{Binding LastLoginAt}" Width="170" ElementStyle="{StaticResource AccountCellText}"/>
                <DataGridTextColumn x:Name="StatusColumn" Header="状态" Binding="{Binding Status}" Width="85" ElementStyle="{StaticResource AccountCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
