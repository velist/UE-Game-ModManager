<Window x:Class="UEModManager.Views.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UEModManager.Localization"
        Title="{loc:Text &#x27;捐赠支持&#x27;}"
        Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource CyberModalWindow}"
        ResizeMode="NoResize">

    <StackPanel Margin="24,20,24,24">
        <!-- 标题 -->
        <TextBlock Text="{loc:Text &#x27;支持MOD管理器开发&#x27;}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource Text100Brush}"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Text="{loc:Text &#x27;请我喝一杯咖啡~&#x27;}" FontSize="12"
                   Foreground="{StaticResource Text500Brush}"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <!-- 二维码 -->
        <Border CornerRadius="14" Background="White" Padding="12"
                HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/捐赠.png" Width="200" Height="200"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <TextBlock Text="{loc:Text &#x27;微信扫一扫&#x27;}" FontSize="11"
                   Foreground="{StaticResource Text600Brush}"
                   HorizontalAlignment="Center" Margin="0,12,0,0"/>

        <Button Content="{loc:Text &#x27;关闭&#x27;}" Width="88" Height="34" Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource CyberSecondaryButton}"
                Click="CloseButton_Click" IsCancel="True"/>
    </StackPanel>
</Window>
