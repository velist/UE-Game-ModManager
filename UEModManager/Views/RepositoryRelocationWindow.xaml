<Window x:Class="UEModManager.Views.RepositoryRelocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UEModManager.Localization"
        Title="{loc:Text &#x27;搬移 MOD 存放位置&#x27;}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource CyberModalWindow}">

    <!--
        一个窗口，三个状态：确认 → 进行中 → 结果。
        刻意不拆成三个对话框：普通玩家每多关掉一个框就多一次"这是要干嘛"的犹豫，
        而这三步说的是同一件事。整条一键流程因此只需要点三下
        （帮我搬 → 开始搬 → 知道了），中间不换窗口、位置不跳。
    -->
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="OnCloseWindow"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 标题 ═══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,20,24,10">
            <TextBlock x:Name="TitleGlyph" Text="&#xE8DE;" FontFamily="Segoe MDL2 Assets"
                       FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource Text100Brush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ═══ 从哪搬到哪：只在确认阶段显示 ═══ -->
        <Border x:Name="RoutePanel" Grid.Row="1" Margin="24,0,24,12" Padding="14,12"
                Background="{StaticResource BgBaseBrush}"
                BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Text &#x27;现在存在&#x27;}" FontSize="12"
                           Foreground="{StaticResource Text500Brush}" Margin="0,0,10,4"/>
                <TextBlock x:Name="SourceText" Grid.Row="0" Grid.Column="1" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{StaticResource Text400Brush}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Text &#x27;搬到&#x27;}" FontSize="12"
                           Foreground="{StaticResource Text500Brush}" Margin="0,0,10,0"/>
                <TextBlock x:Name="TargetText" Grid.Row="1" Grid.Column="1" FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource PrimaryLightBrush}"/>
            </Grid>
        </Border>

        <!-- ═══ 正文：三个阶段共用同一块，只换文字 ═══ -->
        <StackPanel Grid.Row="2" Margin="24,0,24,16">
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                       Foreground="{StaticResource Text400Brush}"/>

            <!-- 进度：仓库为空时整条流程根本不弹这个窗口，所以这里不存在"0 个文件"的情形 -->
            <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="MoveProgressBar" Style="{StaticResource CyberProgressBar}"
                             Minimum="0" Maximum="100" Height="6"/>
                <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,8,0,0"
                           Foreground="{StaticResource Text400Brush}"/>
                <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Text500Brush}"
                           Text="{loc:Text &#x27;搬的过程中请不要关掉程序。就算真的断电了也不会丢东西，下次打开会自动接着弄完。&#x27;}"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══ 按钮 ═══ -->
        <Border Grid.Row="3" Background="{StaticResource TitlebarBrush}"
                BorderBrush="{StaticResource CyberBorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" Width="110" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource CyberSecondaryButton}" Click="Secondary_Click"/>
                <Button x:Name="PrimaryButton" MinWidth="130" Height="34" Padding="14,0"
                        Style="{StaticResource CyberPrimaryButton}" Click="Primary_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
