<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════
         Cyber Dark Theme — 设计令牌层（唯一事实来源）
         基于 Pencil 原型设计系统 ｜ 纯黑底 + 青色(Cyan)强调

         本文件**只放设计令牌**：Color / SolidColorBrush / LinearGradientBrush /
         CornerRadius / FontFamily。控件样式（Style / ControlTemplate）一律放
         CyberStyles.xaml，并通过 {StaticResource} 引用这里的令牌。

         为什么这样分：此前两个文件重复定义了 69 个 x:Key，App.xaml 的合并顺序
         让 CyberStyles.xaml 胜出，本文件里那 69 个定义全是死资源——有人来这里
         调色，运行后一点变化都没有。现在令牌只有这一份，改这里就一定生效。

         将来要做浅色主题：复制本文件改取值，然后只改 App.xaml 里合并的第一项，
         CyberStyles.xaml 无需任何改动。

         注意：<Color> 的 8 位十六进制是 #AARRGGBB（透明度在前）。下方几个 "Bg"
         色标写成了 #RRGGBBAA 的形状，实际解析出来透明度极低。保持原样是为了
         不改变现有观感——修正它属于视觉变更，需单独评审。
         ════════════════════════════════════════════════════════════ -->

    <!-- ── 基础色 ── -->
    <Color x:Key="BgBaseColor">#030303</Color>
    <Color x:Key="SurfaceColor">#0f0f11</Color>
    <Color x:Key="SurfaceHoverColor">#1a1a1d</Color>
    <Color x:Key="TitlebarColor">#0a0a0c</Color>

    <!-- ── 强调色 ── -->
    <Color x:Key="PrimaryColor">#06b6d4</Color>
    <Color x:Key="PrimaryHoverColor">#0891b2</Color>
    <Color x:Key="PrimaryLightColor">#22d3ee</Color>
    <Color x:Key="PrimaryGlowColor">#06b6d440</Color>

    <!-- ── 边框与遮罩 ── -->
    <Color x:Key="BorderColor">#27272a</Color>
    <Color x:Key="BorderLightColor">#3f3f46</Color>
    <Color x:Key="OverlayColor">#CC000000</Color>

    <!-- ── 文字梯度 ── -->
    <Color x:Key="Text100Color">#f4f4f5</Color>
    <Color x:Key="Text200Color">#e4e4e7</Color>
    <Color x:Key="Text300Color">#d4d4d8</Color>
    <Color x:Key="Text400Color">#a1a1aa</Color>
    <Color x:Key="Text500Color">#71717a</Color>
    <Color x:Key="Text600Color">#52525b</Color>
    <Color x:Key="Text700Color">#3f3f46</Color>

    <!-- ── 状态色 ── -->
    <Color x:Key="StatusGreenColor">#22c55e</Color>
    <Color x:Key="StatusOrangeColor">#f97316</Color>
    <Color x:Key="StatusRedColor">#ef4444</Color>
    <Color x:Key="CloseHoverColor">#dc2626</Color>
    <Color x:Key="ClosePressedColor">#b91c1c</Color>

    <!-- ── 下拉 / 列表项 / 分隔线 ── -->
    <Color x:Key="DropdownBgColor">#0f0f11</Color>
    <Color x:Key="DropdownBorderColor">#3f3f46</Color>
    <Color x:Key="ItemHoverColor">#1a1a1d</Color>
    <Color x:Key="ItemActiveColor">#1a1a1d</Color>
    <Color x:Key="ItemActiveBorderColor">#27272a80</Color>
    <Color x:Key="DividerColor">#27272a99</Color>

    <!-- ── v2.0 类型色标（MOD / 插件 / 配置 + 冲突胜负底色） ──
         Bg 系列是半透明底色。8 位十六进制在 WPF 里是 #AARRGGBB（透明度在前），
         这几个 key 原先写成了 #RRGGBBAA，解析出来是几乎全透明的错色。
         已按原意（RGB + 0x20/0x18 透明度）改正——改正前它们没有任何消费者，
         所以这次修正不改变任何一个像素；现在 ValueConverters 开始引用它们。 -->
    <Color x:Key="PluginPurpleColor">#a855f7</Color>
    <Color x:Key="ConfigAmberColor">#f59e0b</Color>
    <Color x:Key="ModCyanBgColor">#2006b6d4</Color>
    <Color x:Key="PluginPurpleBgColor">#20a855f7</Color>
    <Color x:Key="ConfigAmberBgColor">#20f59e0b</Color>
    <Color x:Key="WinnerGreenBgColor">#1822c55e</Color>
    <Color x:Key="LoserRedBgColor">#18ef4444</Color>

    <!-- ════════════════════════════════════════════════════════════
         画刷 —— 一律由上方 Color 派生，不要在这里写第二份色值
         ════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBaseColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="TitlebarBrush" Color="{StaticResource TitlebarColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="{StaticResource PrimaryGlowColor}"/>

    <SolidColorBrush x:Key="CyberBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>

    <SolidColorBrush x:Key="Text100Brush" Color="{StaticResource Text100Color}"/>
    <SolidColorBrush x:Key="Text200Brush" Color="{StaticResource Text200Color}"/>
    <SolidColorBrush x:Key="Text300Brush" Color="{StaticResource Text300Color}"/>
    <SolidColorBrush x:Key="Text400Brush" Color="{StaticResource Text400Color}"/>
    <SolidColorBrush x:Key="Text500Brush" Color="{StaticResource Text500Color}"/>
    <SolidColorBrush x:Key="Text600Brush" Color="{StaticResource Text600Color}"/>
    <SolidColorBrush x:Key="Text700Brush" Color="{StaticResource Text700Color}"/>

    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreenColor}"/>
    <SolidColorBrush x:Key="StatusOrangeBrush" Color="{StaticResource StatusOrangeColor}"/>
    <SolidColorBrush x:Key="StatusRedBrush" Color="{StaticResource StatusRedColor}"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="{StaticResource ClosePressedColor}"/>

    <!-- 语义别名：与上面的状态色同源，供业务代码按语义引用 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource StatusGreenColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource StatusOrangeColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource StatusRedColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource StatusRedColor}"/>

    <SolidColorBrush x:Key="DropdownBgBrush" Color="{StaticResource DropdownBgColor}"/>
    <SolidColorBrush x:Key="DropdownBorderBrush" Color="{StaticResource DropdownBorderColor}"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="{StaticResource ItemHoverColor}"/>
    <SolidColorBrush x:Key="ItemActiveBrush" Color="{StaticResource ItemActiveColor}"/>
    <SolidColorBrush x:Key="ItemActiveBorderBrush" Color="{StaticResource ItemActiveBorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <!-- v2.0 类型色标画刷 -->
    <SolidColorBrush x:Key="PluginPurpleBrush" Color="{StaticResource PluginPurpleColor}"/>
    <SolidColorBrush x:Key="ConfigAmberBrush" Color="{StaticResource ConfigAmberColor}"/>
    <SolidColorBrush x:Key="ModCyanBgBrush" Color="{StaticResource ModCyanBgColor}"/>
    <SolidColorBrush x:Key="PluginPurpleBgBrush" Color="{StaticResource PluginPurpleBgColor}"/>
    <SolidColorBrush x:Key="ConfigAmberBgBrush" Color="{StaticResource ConfigAmberBgColor}"/>
    <SolidColorBrush x:Key="WinnerGreenBgBrush" Color="{StaticResource WinnerGreenBgColor}"/>
    <SolidColorBrush x:Key="LoserRedBgBrush" Color="{StaticResource LoserRedBgColor}"/>

    <!-- v2.0 UX优化: 渐变按钮画刷 -->
    <LinearGradientBrush x:Key="ImportButtonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#06b6d4" Offset="0"/>
        <GradientStop Color="#0891b2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LaunchButtonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10b981" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>

    <!-- ════════════════════════════════════════════════════════════
         尺寸与字体
         ════════════════════════════════════════════════════════════ -->

    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusXl">20</CornerRadius>

    <!-- 嵌入思源黑体 SC（Adobe SIL OFL 1.1）— Regular 字形覆盖所有中文显示。
         WPF 在缺字形时自动回退到系统字体（Segoe UI / 微软雅黑）处理拉丁字符。
         FontWeight=Medium/Bold 时 WPF 自动从 Medium/Bold 字形匹配。
         资源 key 沿用 InterFont 名以保持向后兼容（22 处 XAML 引用无需修改）。 -->
    <FontFamily x:Key="InterFont">pack://application:,,,/Fonts/#Source Han Sans SC, Microsoft YaHei UI, Segoe UI</FontFamily>

</ResourceDictionary>
